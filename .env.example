# Ride request form (app/actions/requestRide.ts)
# Copy to .env.local and fill in. Without RESEND_API_KEY in development, requests are
# printed to the server console instead of emailed; in production the form shows an
# error asking visitors to call.

# API key from https://resend.com (API Keys). Required in production.
RESEND_API_KEY=

# Where ride requests are delivered. Defaults to the company email in lib/site.ts.
BOOKING_TO=odesmedicaltransportation@yahoo.com

# Sender address. Must be on a domain you have verified in Resend, e.g.
# "Odes Website <bookings@your-domain.com>". The default onboarding@resend.dev sender
# can only deliver to the email address that owns the Resend account.
BOOKING_FROM=
